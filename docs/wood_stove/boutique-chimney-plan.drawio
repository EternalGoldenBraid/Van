        <mxCell id="fixing-kit-contents" value="70-178 mm pipe range; 254 x 254 mm base listed.&lt;br&gt;EUR 228.50 incl. VAT; listed lead time 10-15 working days.&lt;br&gt;Finland packet shipping EUR 17.90 published; check total." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#243447;strokeColor=none;fillColor=none;">
